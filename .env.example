# Atlas public-data screener. Binance account credentials are not used.
ATLAS_ENVIRONMENT=development
ATLAS_STATE_DB_PATH=atlas_state.sqlite3
ATLAS_SCREENER_CRON_ENABLED=true
ATLAS_SCREENER_INTERVAL_HOURS=1
# Reuse spare shortlist places inside the existing discovery enrichment ceiling (75).
# false restores the fixed 45/30 split; qualification thresholds remain unchanged.
ATLAS_STAGE2_CAPACITY_ROLLOVER_ENABLED=true
ATLAS_EXCLUDED_BASE_ASSETS=USDT,USDC,FDUSD,TUSD,USDP,DAI,EUR

# The production Compose service forwards only the screener variables it declares.
# Legacy ATLAS_EXECUTION_MODE, ATLAS_AUTOMATION_ENABLED and Binance keys have no effect.
# Remove old exchange credentials from the deployed environment and revoke them.

# Experimental local research only; production Compose does not forward this flag.
# Keep disabled until archived replay and independent validation support promotion.
ATLAS_BEARISH_CONTINUATION_ENABLED=false

# Private production-hosted canary: reuses captured inputs, no network/publication.
# Mutually exclusive with continuation publication; both remain disabled by default.
ATLAS_BEARISH_CONTINUATION_CANARY_ENABLED=false
ATLAS_CONTINUATION_CANARY_MAX_SYMBOLS=30
ATLAS_CONTINUATION_CANARY_SECONDS=10
ATLAS_CONTINUATION_CANARY_REPORTS=48
