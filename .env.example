# Safe default: no real orders are possible without changing all three gates.
ATLAS_ENVIRONMENT=development
ATLAS_EXECUTION_MODE=paper
ATLAS_LIVE_TRADING_ENABLED=false
ATLAS_LIVE_TRADING_ACK=

# Operator API. Generate a long random value; never commit the real token.
ATLAS_OPERATOR_TOKEN=
ATLAS_ALLOWED_HOSTS=localhost,127.0.0.1

# Disabled by default. Discover every confirmed hourly close, but permit at most one
# successful entry per rolling eight-hour cooldown.
ATLAS_AUTOMATION_ENABLED=false
ATLAS_SIGNAL_DISCOVERY_INTERVAL_HOURS=1
ATLAS_EXECUTION_COOLDOWN_HOURS=8
ATLAS_SIGNAL_EXPIRY_BARS=2
ATLAS_EXECUTION_LEASE_SECONDS=300
ATLAS_BAR_CLOSE_GRACE_SECONDS=30
ATLAS_SCHEDULER_FAILURE_LIMIT=3

# Binance Spot Testnet credentials: https://testnet.binance.vision/
ATLAS_BINANCE_SPOT_API_KEY=
ATLAS_BINANCE_SPOT_API_SECRET=

# Binance USD-M Futures Testnet credentials.
ATLAS_BINANCE_FUTURES_API_KEY=
ATLAS_BINANCE_FUTURES_API_SECRET=
ATLAS_BINANCE_FUTURES_HEDGE_MODE=true

# Optional exceptions for post-baseline testnet deltas that intentionally have no USDT market.
# This list is ignored in live mode.
ATLAS_IGNORED_SPOT_BALANCE_ASSETS=

# Risk defaults are intentionally conservative.
ATLAS_ACCOUNT_RISK_PER_TRADE=0.0025
ATLAS_MAX_DAILY_LOSS=0.02
ATLAS_MAX_INTRADAY_MARK_TO_MARKET_LOSS=0.03
ATLAS_MAX_DRAWDOWN=0.05
ATLAS_MAX_OPEN_POSITIONS=3
ATLAS_MAX_SAME_DIRECTION_CRYPTO_POSITIONS=2
ATLAS_MAX_ABS_BTC_BETA=2.0
ATLAS_MAX_BTC_CORRELATION=0.80
ATLAS_MAX_BTC_CORRELATED_POSITIONS=2
ATLAS_MAX_GROSS_EXPOSURE=1.0
ATLAS_MAX_FUTURES_LEVERAGE=3
ATLAS_FUTURES_MARGIN_FRACTION_PER_POSITION=0.33333333
ATLAS_PAPER_STARTING_EQUITY=100000
ATLAS_PAPER_SPOT_ALLOCATION=0.5
# Alternative profiles remain research-only. regime_breakout_v2 uses 7d/30d momentum plus a
# 40h breakout and demotes MACD/RSI/ADX to low-weight diagnostics. trend_quality_v3 adds an
# auditable 2-of-4 EMA/MACD/RSI/ADX consensus. empirical_tsmom_v5 is the preserved baseline;
# layered_tsmom_v6 adds direction-normalized long/short momentum and hard/soft gate separation;
# early_momentum_v7 preregisters a volume breakout -> held retest -> resumption event.
# None has passed promotion evidence, so the legacy baseline stays selected and automation is off.
ATLAS_STRATEGY_PROFILE=legacy_momentum_v1
ATLAS_MIN_CANDIDATE_SCORE=70
ATLAS_MAX_SYMBOLS_TO_ANALYZE=40
ATLAS_COLLECT_DERIVATIVES_FEATURES=true
ATLAS_MIN_4H_HISTORY_BARS=480
ATLAS_BREAKOUT_LOOKBACK_HOURS=40
# Long and short profiles require independent evidence. The current breakout short sleeve
# failed the six-asset diagnostic and therefore remains disabled.
ATLAS_BREAKOUT_SHORTS_ENABLED=false
ATLAS_VOLATILITY_REGIME_LOOKBACK_HOURS=120
ATLAS_MIN_VOLATILITY_PERCENTILE=0.20
ATLAS_MAX_VOLATILITY_PERCENTILE=0.90
ATLAS_BREAKOUT_MIN_RELATIVE_VOLUME=0.80
ATLAS_TREND_QUALITY_MIN_CONFIRMATIONS=2
ATLAS_SLOW_MOMENTUM_SHORTS_ENABLED=true
ATLAS_SLOW_BREAKOUT_4H_BARS=30
# empirical_tsmom_v5 is research-only and rejected by configuration in live mode. Breakout and
# pullback are separate hypotheses; do not combine or select between them using holdout results.
ATLAS_EMPIRICAL_SETUP=breakout
ATLAS_EMPIRICAL_SHORTS_ENABLED=false
ATLAS_EMPIRICAL_BREAKOUT_4H_BARS=30
# layered_tsmom_v6 is also research/testnet-only. Shorts are mathematically symmetric but still
# need independent empirical evidence and explicit operator authority.
ATLAS_LAYERED_SETUP=breakout
ATLAS_LAYERED_SHORTS_ENABLED=false
ATLAS_LAYERED_BREAKOUT_4H_BARS=30
# early_momentum_v7 is hourly and research-only. Do not tune these defaults against its declared
# holdouts; create a new version if the hypothesis changes.
ATLAS_EARLY_MOMENTUM_SHORTS_ENABLED=false
ATLAS_EARLY_BREAKOUT_LOOKBACK_HOURS=20
ATLAS_EARLY_BREAKOUT_MAX_AGE_HOURS=8
ATLAS_EARLY_BREAKOUT_MIN_RELATIVE_VOLUME=1.25
ATLAS_EARLY_RETEST_TOUCH_BUFFER_ATR=0.50
ATLAS_EARLY_RETEST_HOLD_BUFFER_ATR=0.25
ATLAS_RSI_DIVERGENCE_LOOKBACK_HOURS=72
ATLAS_RSI_DIVERGENCE_MAX_AGE_HOURS=12
ATLAS_RSI_DIVERGENCE_MIN_DELTA=3
ATLAS_SUPPORT_RESISTANCE_LOOKBACK_BARS=48
ATLAS_KEY_LEVEL_BUFFER_ATR=0.5
ATLAS_MAX_ENTRY_CHASE_ATR=0.5
ATLAS_ENTRY_LIMIT_OFFSET_BPS=5
ATLAS_MOMENTUM_LOOKBACK_BARS=3
ATLAS_MOMENTUM_MIN_RISING_CHECKS=3
ATLAS_REQUIRE_PULLBACK_CONFIRMATION=false
ATLAS_PULLBACK_LOOKBACK_BARS=6
ATLAS_PULLBACK_TOUCH_BUFFER_ATR=0.25
ATLAS_PULLBACK_REQUIRE_PREVIOUS_BAR_BREAK=false
ATLAS_MIN_4H_ADX=0
ATLAS_REQUIRE_4H_DI_ALIGNMENT=false
ATLAS_MAX_ENTRY_EXTENSION_FROM_EMA20_ATR=10
ATLAS_MAX_ATR_FRACTION=1
ATLAS_EXCLUDED_BASE_ASSETS=USDT,USDC,FDUSD,TUSD,USDP,DAI,EUR
ATLAS_EXCLUDE_MULTIPLIER_CONTRACTS=true
ATLAS_ATR_STOP_MULTIPLE=1.5
ATLAS_PROTECTIVE_LEVEL_BUFFER_ATR=0.25
ATLAS_MAX_STRUCTURAL_STOP_DISTANCE_ATR=3
ATLAS_REWARD_RISK_MULTIPLE=2
ATLAS_MIN_REWARD_RISK_MULTIPLE=1.5
ATLAS_STATE_DB_PATH=atlas_state.sqlite3
# Bound analytical/audit growth in the operational SQLite file. Export older research data to
# durable analytical storage before the retention window expires.
ATLAS_RESEARCH_RETENTION_DAYS=730
ATLAS_EVENT_RETENTION_DAYS=730
ATLAS_RESEARCH_REPORT_LOOKBACK_DAYS=180
