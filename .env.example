# Atlas public-data screener. Binance account credentials are not used.
ATLAS_ENVIRONMENT=development
ATLAS_STATE_DB_PATH=atlas_state.sqlite3
ATLAS_SCREENER_CRON_ENABLED=true
ATLAS_SCREENER_INTERVAL_HOURS=4
ATLAS_EXCLUDED_BASE_ASSETS=USDT,USDC,FDUSD,TUSD,USDP,DAI,EUR

# The production Compose service forwards only the screener variables it declares.
# Legacy ATLAS_EXECUTION_MODE, ATLAS_AUTOMATION_ENABLED and Binance keys have no effect.
# Remove old exchange credentials from the deployed environment and revoke them.
